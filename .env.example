# =====================================================================
# Variables de entorno. Copia este archivo a apps/web/.env.local (web) y
# rellena los valores. NUNCA subas claves reales al repositorio.
# Con Supabase local, `pnpm exec supabase status` muestra las claves de desarrollo.
# =====================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AyudaCerca
NEXT_PUBLIC_APP_ENV=development        # development | preview | production
NEXT_PUBLIC_DEMO_MODE=1                # 1 = muestra la franja «Entorno de demostración»

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=             # solo servidor

# --- Stripe (vacío = simulador de pagos) ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- Correo (vacío = se muestra en la consola y en Mailpit local) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Push web ---
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# --- Captcha (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting distribuido ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observabilidad ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Tareas programadas ---
CRON_SECRET=

# --- App móvil (apps/mobile/.env) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3000
